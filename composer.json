{
    "name": "tyhpdef/illuminate-reflection-impl",
    "description": "Implementation package for tyhpdef/illuminate-reflection. Require tyhpdef/illuminate-reflection, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "13.33.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/illuminate-collections": "@dev",
                "tyhpdef/illuminate-contracts": "@dev",
                "tyhpdef/illuminate-conditionable": "@dev",
                "tyhpdef/illuminate-macroable": "@dev",
                "tyhpdef/psr-container": "@dev",
                "tyhpdef/psr-simple-cache": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/illuminate-reflection"
        }
    },
    "require": {
        "php": ">=8.2",
        "illuminate/reflection": "13.33.0",
        "tyhpdef/illuminate-collections": "^13.0",
        "tyhpdef/illuminate-contracts": "^13.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/illuminate-collections": "@dev",
        "tyhpdef/illuminate-contracts": "@dev",
        "tyhpdef/illuminate-conditionable": "@dev",
        "tyhpdef/illuminate-macroable": "@dev",
        "tyhpdef/psr-container": "@dev",
        "tyhpdef/psr-simple-cache": "@dev"
    }
}
